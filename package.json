{
  "name": "orcus-ethglobal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "agent",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "start": "node scripts/web.mjs start",
    "worker": "node --env-file-if-exists=.env --import tsx agent/src/worker.ts",
    "build": "node scripts/web.mjs build",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "demo:setup": "node --import tsx -- scripts/demo-setup.ts",
    "verify:compute": "node --import tsx scripts/verify-compute.ts",
    "verify:storage": "node --env-file-if-exists=.env --import tsx scripts/verify-storage.ts",
    "verify:uniswap-fork": "node --env-file-if-exists=.env --import tsx scripts/verify-uniswap-fork.ts",
    "verify:kernel-fork": "node --env-file-if-exists=.env --import tsx scripts/verify-kernel-fork.ts",
    "verify:operator-paymaster-fork": "node --env-file-if-exists=.env --import tsx scripts/verify-kernel-fork.ts --operator-paymaster",
    "compile:paymaster": "node --import tsx scripts/compile-operator-paymaster.ts",
    "test:contracts": "vitest run --maxWorkers=2 --no-file-parallelism scripts/lib/compile-operator-paymaster.test.ts packages/wallets/src/operator-paymaster.test.ts",
    "verify:hyperliquid": "node --env-file-if-exists=.env --import tsx scripts/verify-hyperliquid.ts",
    "verify:browser": "node --import tsx scripts/verify-browser.ts",
    "verify:cre": "node --env-file-if-exists=.env --import tsx scripts/verify-cre.ts",
    "verify:service-payment-fork": "node --import tsx scripts/verify-service-payment-fork.ts",
    "verify:compute-funding-fork": "node --import tsx scripts/verify-compute-funding-fork.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cre": "vitest run --maxWorkers=2 --no-file-parallelism workflows/cre/strategy/*.test.ts"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "axios@<0.34.0": "0.34.0",
    "ws@^8.0.0": "8.21.0",
    "bn.js@^4.0.0": "4.12.3",
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@openzeppelin/contracts": "5.0.2",
    "@types/node": "^22.15.0",
    "solc": "0.8.28",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
