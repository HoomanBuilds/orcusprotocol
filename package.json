{
  "name": "orcus-ethglobal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web", "agent", "packages/*"],
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "start": "node scripts/web.mjs start",
    "worker": "node --env-file-if-exists=.env --import tsx agent/src/worker.ts",
    "build": "node scripts/web.mjs build",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "verify:compute": "node --import tsx scripts/verify-compute.ts",
    "verify:storage": "node --env-file-if-exists=.env --import tsx scripts/verify-storage.ts",
    "verify:uniswap-fork": "node --env-file-if-exists=.env --import tsx scripts/verify-uniswap-fork.ts",
    "verify:kernel-fork": "node --env-file-if-exists=.env --import tsx scripts/verify-kernel-fork.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cre": "vitest run workflows/cre/strategy/workflow.test.ts"
  },
  "engines": { "node": ">=22.16.0" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
