{
  "name": "orcus-ethglobal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web", "agent", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @orcus/web",
    "worker": "npm run worker --workspace @orcus/engine",
    "build": "npm run build --workspace @orcus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=22.16.0" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
