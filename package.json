{
  "name": "orcus-ethglobal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["web", "agent", "packages/*"],
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev web --hostname 0.0.0.0",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start web --hostname 0.0.0.0",
    "worker": "node --env-file-if-exists=.env --import tsx agent/src/worker.ts",
    "build": "node --env-file-if-exists=.env node_modules/next/dist/bin/next build web",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=22.16.0" },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
