# Root scripts load this file. Copy to .env locally; never commit credentials.
ORCUS_APP_URL=http://localhost:3000

# Set a random token shared only by web and the background worker.
ORCUS_INTERNAL_TOKEN=

# Required for production. Development generates an owner-only local key.
# Use 32 random bytes encoded as hex or base64. Do not reuse a wallet key.
ORCUS_MASTER_KEY=
# ORCUS_DATA_DIR=/absolute/private/runtime-directory
ORCUS_WORKER_INTERVAL_MS=10000

# Public read RPC and server-only Sepolia account-abstraction bundler.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ZERODEV_RPC_URL=

# Use the exact endpoint, model and credential supplied for your 0G account.
# No provider credential or model is bundled with this application.
ZEROG_COMPUTE_CHAT_URL=
ZEROG_COMPUTE_API_KEY=
ZEROG_COMPUTE_MODEL=
ORCUS_COMPUTE_RESERVATION_USD=0.01
# Optional verified credit-balance endpoint. Wallet funds are not compute credits.
# ZEROG_COMPUTE_BALANCE_URL=https://your-verified-provider-balance-endpoint

# Memory is encrypted before upload. Only Galileo testnet writes are allowed.
ZEROG_STORAGE_ENABLED=false
ZEROG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Real CRE CLI local simulation; authenticate with cre login or CRE_API_KEY.
CRE_ENABLED=false
CRE_CLI_PATH=cre
# CRE_WORKFLOW_DIR=/absolute/path/to/this-repository/workflows/cre
CRE_TARGET=staging-settings
# CRE_API_KEY=

# These are not private-execution switches. TEE use needs verified attestation.
# Sponsor credits and an owner-funded budget do not prove earned revenue.
