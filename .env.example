# Root scripts load this file. Copy to .env locally; never commit credentials.
ORCUS_APP_URL=http://localhost:3000
# Optional private worker destination. Public wallet-login origin stays above.
ORCUS_INTERNAL_APP_URL=http://127.0.0.1:3000

# Set a random token shared only by web and the background worker.
ORCUS_INTERNAL_TOKEN=

# Required for hosted runtime. demo:setup fills missing secrets without printing them.
# Use 32 random bytes encoded as hex or base64. Do not reuse a wallet key.
ORCUS_MASTER_KEY=
# Persistent private SQLite and key directory outside the checkout.
# npm run demo:setup -- --app-url https://HOST --data-dir /var/lib/orcus/data
# ORCUS_DATA_DIR=/absolute/private/runtime-directory
ORCUS_WORKER_INTERVAL_MS=10000

# Public read RPC and server-only Sepolia account-abstraction bundler.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ERC-4337 bundler only. Trading smart accounts pay their own Sepolia ETH gas.
# No paymaster or platform gas-funding key is used.
BUNDLER_RPC_URL=

# A configured key defaults to the official production Router and 0gm-1.0-35b-a3b.
# Override endpoint and model for your own verified account/catalog selection.
ZEROG_COMPUTE_CHAT_URL=
ZEROG_COMPUTE_API_KEY=
# Non-secret public key ID from the same Router account. Bind before making calls
# to enable exact per-request history recovery; never paste the secret key here.
ZEROG_COMPUTE_API_KEY_ID=
ZEROG_COMPUTE_MODEL=
ZEROG_COMPUTE_MANAGEMENT_KEY=
# Private mode is selected explicitly per user. Independent assurance requires
# the official verifier plus the deployment's hash-matching raw manifest.
# ZEROG_PRIVATE_VERIFIER_PATH=/absolute/path/to/pcverify
# ZEROG_PRIVATE_APP_COMPOSE_PATH=/absolute/path/to/app-compose.json
# ZEROG_PRIVATE_EXPECTED_COMPOSE_PATH=/absolute/path/to/published-compose.yaml
ZEROG_PRIVATE_NETWORK=mainnet
ORCUS_COMPUTE_RESERVATION_USD=0.01
# Operator-enforced UTC-day USD-equivalent ceilings across all inference calls.
# Owner expense caps and paid test credits cannot raise these ceilings.
ORCUS_COMPUTE_USER_DAILY_USD=1
ORCUS_COMPUTE_PROJECT_DAILY_USD=10
# Optional checkout on Sepolia only. Test USDC and resulting credits have no value.
# Expense caps and test-only paid service credits are separate ledgers.
ORCUS_SERVICE_PAYMENT_MODE=disabled
ORCUS_SERVICE_PAYMENT_TREASURY=
# Router balance needs a management key with account:read, not an inference key.
# The configured provider account can be shared; it is not a per-user credit pool.
# Optional legacy balance endpoint. Its units are not verified as 0G or USD.
# ZEROG_COMPUTE_BALANCE_URL=https://your-verified-provider-balance-endpoint

# Memory is encrypted before upload. Only Galileo testnet writes are allowed.
ZEROG_STORAGE_ENABLED=false
ZEROG_STORAGE_PAYER=operator
# Local testnet-only platform payer. Use a dedicated limited wallet in production.
ZEROG_STORAGE_SPONSOR_PRIVATE_KEY=
ZEROG_STORAGE_SPONSOR_MAX_GAS_0G=0.003
ZEROG_STORAGE_SPONSOR_MAX_STORAGE_FEE_0G=0.01
ZEROG_STORAGE_SPONSOR_DAILY_CAP_0G=0.05
# Optional advanced alternative: ZEROG_STORAGE_PAYER=agent requires each isolated
# agent operating wallet to hold Galileo 0G. Operator mode does not.
ZEROG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# Real CRE CLI local simulation; authenticate with cre login or CRE_API_KEY.
CRE_ENABLED=false
CRE_CLI_PATH=cre
# CRE_WORKFLOW_DIR=/absolute/path/to/this-repository/workflows/cre
CRE_TARGET=staging-settings
# CRE_API_KEY=

# Optional operator-funded Brave web/news search. Unset means unavailable, not fake results.
BRAVE_SEARCH_API_KEY=

# Galileo native top-ups require a matching testnet Router account and owner policy.
# The production Router and Galileo PaymentVault are not the same payment pool.
# Sponsor credits and an owner-funded budget do not prove earned revenue.
